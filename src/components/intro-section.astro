---

import '../styles/global.css'
import BitwiseLogo from './bitwise-logo.astro'

---

<div class="page-wrapper">

        <div class="grid-container">
            <div class="horizontal-borders top"></div>
            <div class="vertical-borders left"> </div>
            <div class="vertical-borders right"> </div>
                <div class="content">
                    <div class="logo-and-text">
                        <BitwiseLogo/>
                        <h1> Brand Assets </h1>
                    </div>
                    <div class="quick-links"> 
                    <a href="#logo"> Logo</a>
                    <div class="vertical-line"> </div>
                    <a href="#logo"> Typography</a>
                    <div class="vertical-line"> </div>
                    <a href="#logo"> Colors</a>
                    </div>
                </div>
            <div class="horizontal-borders bottom"></div>
        </div>
        
    </div>

</div>



<style>

.logo-and-text{
    display: flex;
    flex-direction: column;
    gap: 50px;
    align-items: center;
}

.horizontal-borders.top {
    grid-column: 1 / -1;
    grid-row: 2;
}

.horizontal-borders.bottom {
    grid-column: 2 / -2;
    grid-row: 4;
}

.vertical-borders.left{
    border-left: 1px solid #D7DBDF;
    border-right: 1px solid #D7DBDF;
    width: 40px;
    grid-row: 1 / -1;
    grid-column: 2;

}

.vertical-borders.right{
    border-left: 1px solid #D7DBDF;
    border-right: 1px solid #D7DBDF;
    width: 40px;
    grid-row: 1 / -1;
    grid-column: 4;

}

.horizontal-borders{
    border-bottom: 1px solid #D7DBDF;
    border-top: 1px solid #D7DBDF;
    height: 40px;
    width: 100%;
    grid-column: 1 / -1;

}

.content{
    background-image: url(../assets/website-images/brand-bg.jpg);
    background-size: contain;  
    box-sizing: border-box;
    padding-top: 100px;
    background-position: center; 
    background-repeat: no-repeat;
    height: 100%;
    gap: 200px;
    display: flex;
    flex-direction: column;
    grid-column: 3;
    grid-row: 3;
}

.vertical-line{
    border-left: 1px solid #D7DBDF;
    height: 120px;
}



.page-wrapper{
    width: 1600px;
    margin: 0 auto;
}


.grid-container{
    display: grid;
    grid-template-columns: 100px auto 1fr auto 100px;
    grid-template-rows: 100px auto 1fr auto 100px;
    width: 100%;
    position: relative;
}

.header-and-content{
    display: flex;
    flex-direction: row;

}

.vertical-borders{
    border-left: 1px solid #D7DBDF;
    border-right: 1px solid #D7DBDF;
    width: 40px;
    grid-row: 1 / -1;

}




.quick-links{
    display: flex;
    flex-direction: row;
    width: 100%;
    justify-content: space-evenly;
    background: rgba(0, 0, 0, 0.05);
    backdrop-filter: blur(1px);
    align-items: center;
    border-top: 1px solid #D7DBDF;
}

a:hover{
color: rgba(0, 0, 0, 0.50);
}

</style>