---

import '../styles/global.css'
import BitwiseLogo from './bitwise-logo.astro'

---


<div class="content">
    <div class="logo-and-text">
        <BitwiseLogo/>
        <h1> Brand Assets </h1>
    </div>
</div>


<style>



/* --- CSS PAGE SPECIFIC START --- */

.quick-links{
    display: flex;
    flex-direction: row;
    width: 100%;
    justify-content: space-evenly;
    background: rgba(0, 0, 0, 0.02);
    backdrop-filter: blur(1px);
    align-items: center;
    border-top: 1px solid #D7DBDF;
}

.hover-light{
    transition: opacity 0.2s ease;
}

.hover-light:hover{
    opacity: 0.4;
}

.logo-and-text{
    display: flex;
    flex-direction: column;
    gap: 50px;
    align-items: center;
}


.vertical-line{
    border-left: 1px solid #D7DBDF;
    height: 120px;
}

/* CSS PAGE SPECIFIC END */






/* --- GRID START --- */

.grid-container{
    display: grid;
    grid-template-columns: 100px auto 1fr auto 100px;
    grid-template-rows: 100px auto 1fr auto 100px;
    width: 100%;
    position: relative;
}


.horizontal-borders.top {
    grid-column: 1 / -1;
    grid-row: 2;
}


.horizontal-borders.bottom {
    grid-column: 2 / -2;
    grid-row: 4;
}


.vertical-borders.left{
    border-left: 1px solid #D7DBDF;
    border-right: 1px solid #D7DBDF;
    width: 40px;
    grid-row: 1 / -1;
    grid-column: 2;

}


.vertical-borders.right{
    border-left: 1px solid #D7DBDF;
    border-right: 1px solid #D7DBDF;
    width: 40px;
    grid-row: 1 / -1;
    grid-column: 4;

}


.horizontal-borders{
    border-bottom: 1px solid #D7DBDF;
    border-top: 1px solid #D7DBDF;
    height: 40px;
    width: 100%;
    grid-column: 1 / -1;

}


.vertical-borders{
    border-left: 1px solid #D7DBDF;
    border-right: 1px solid #D7DBDF;
    width: 40px;
    grid-row: 1 / -1;

}

/* --- GRID END --- */


</style>
