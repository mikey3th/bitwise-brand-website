---

import '../styles/global.css'

---


<div>
    <div class="type-assets">

        <div class="asset-row">

            {/* PP Neue Montreal */}

            <div class="asset-and-buttons"> 

                <div class="type-specimen"> 
                    <p class="pp-montreal"> PP Neue Montreal </p>
                    <p class="pp-montreal-body">
                        Bitwise is a trusted partner to investors, financial advisors, family offices, and institutions looking  to understand and
                        access crypto.
                    </p>
                    <a class="download-button">  Primary Font </a> 
                </div> 

            </div>

            <div class="asset-and-buttons"> 

                <div class="type-specimen"> 
                    <p class="items-light"> Items Light </p>
                    <p class="items-body">
                       Crypto Funds Backed by <em> Crypto Specialists </em>
                    </p>
                    <a class="download-button">  Header Font </a> 
                </div> 

            </div>

            <div class="asset-and-buttons"> 

                <div class="type-specimen last"> 
                    <p class="pp-mono-header"> PP Neue Montreal Mono </p>
                    <p class="pp-mono-body">
                        $11B AUM <br>
                        70+Investment products <br>
                        200+Employees <br>
                        5,000+ Wealth teams <br>
                    </p>
                    <a class="download-button">  Data Font </a> 
                </div> 

            </div>


        </div>
    </div>
</div>
    
        





<style>


    .asset-row {
        display: flex;
        flex-direction: row;
        justify-content: space-around;
        padding: 0px;
        /* Ensures the row stretches nicely if the wrapper has a set height */
        align-items: stretch; 
    }

    .asset-and-buttons {
        display: flex;
        flex-direction: column;
        gap: 25px;
        padding: 0px;
        flex: 1;
    }

    .type-specimen {
        display: flex;
        flex-direction: column;
        /* space-between pushes the button to the bottom beautifully */
        justify-content: space-between; 
        gap: 30px;
        align-items: start;
        width: 100%;
        padding: 50px;
        border-right: 1px solid #D7DBDF;
        
        /* THIS IS THE FIX: Tells the inner div to expand vertically to fill the parent */
        flex: 1; 
    }

    .type-specimen.last {
        display: flex;
        flex-direction: column;
        justify-content: space-between;
        gap: 30px;
        align-items: start;
        width: 100%;
        padding: 50px;
        border-right: 0px;
        
        /* THIS IS THE FIX: Tells the inner div to expand vertically to fill the parent */
        flex: 1; 
    }


    .download-button:hover{
        opacity: 100%

    }


    p{
        text-align: left;
    }



    .pp-montreal{
    font-size: 2rem;
    font-weight: 500;
    line-height: 2rem;
    }

    .items-light{
    font-size: 3rem;
    font-weight: 300;
    font-family: "Items";
    line-height: 2rem;
    }

    .items-body{
    font-size: 2rem;
    font-weight: 300;
    font-family: "Items";
    }


    .pp-mono-header{
    font-size: 2rem;
    font-weight: 500;
    font-family: "PP Neue Montreal Mono";
    text-transform: uppercase;
    letter-spacing: .10em;
    line-height: 2rem;
    }

    .pp-mono-body{
    font-size: 1rem;
    line-height: 2rem;
    font-weight: 300;
    font-family: "PP Neue Montreal Mono";
    text-transform: uppercase;
    }


</style>


