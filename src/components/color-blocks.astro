---

import '../styles/global.css'
import ClipboardIcon from '../components/clipboard-icon.astro'

---


<div>
    <div class="type-assets">

        <div class="asset-row">

                <div class="color-specimen"> 
                    <div class="color-block green"> 
                        <span class="hex-copy" data-hex="#39DB80"><ClipboardIcon/></span>
                    </div>
                    <p class="pp-mono-header"> Green </p>
                    <p class="pp-mono-body"> #39DB80 </p>

                </div> 


                <div class="color-specimen"> 
                    <div class="color-block black"> 
                        <span class="hex-copy" data-hex="#000000"><ClipboardIcon/></span>    
                    </div>
                    <p class="pp-mono-header"> Black </p>
                    <p class="pp-mono-body"> #000000 </p>
                </div> 


                <div class="color-specimen"> 
                    <div class="color-block gray">
                        <span class="hex-copy" data-hex="#D7DBDF"><ClipboardIcon/></span>
                    </div>
                    <p class="pp-mono-header"> Gray </p>
                    <p class="pp-mono-body"> #D7DBDF </p>
                </div> 


                <div class="color-specimen last"> 
                    <div class="color-block white"> 
                        <span class="hex-copy dark" data-hex="FFFFFF"><ClipboardIcon/></span>
                    </div>
                    <p class="pp-mono-header"> White </p>
                    <p class="pp-mono-body"> #FFFFFF </p>
                </div> 

        </div>
    </div>
</div>


<script>
    document.querySelectorAll(".hex-copy").forEach((el) => {
        if (!(el instanceof HTMLElement)) return;

        el.addEventListener("click", async () => {
            const hex = el.dataset.hex;
            if (!hex) return;

            try {
                await navigator.clipboard.writeText(hex);
                const original = el.textContent;
                el.textContent = "Copied";
                el.classList.add("copied");
                setTimeout(() => {
                    el.textContent = original;
                    el.classList.remove("copied");
                }, 1000);
            } catch (err) {
                console.error("Copy failed:", err);
            }
        });
    });
</script>
    
        





<style>


    .asset-row {
        display: flex;
        flex-direction: row;
        justify-content: space-around;
        padding: 0px;
        align-items: stretch; 
    }


    .color-specimen {
        display: flex;
        flex-direction: column;
        justify-content: space-between; 
        gap: 30px;
        align-items: start;
        width: 100%;
        padding: 50px;
        border-right: 1px solid #D7DBDF;
        flex: 1; 
    }


    .color-specimen.last {
        display: flex;
        flex-direction: column;
        justify-content: center;
        align-items: flex-start;
        gap: 30px;
        width: 100%;
        padding: 50px;
        border-right: 0px;
        flex: 1; 
    }


    .color-block{
        background-color: #39DB80;
        width: 100%;
        height: 235px;
        border: 1px solid #D7DBDF;
        position: relative;
        display: flex;
        align-items: end;
        justify-content: end;
        padding: 20px;

    }


    .color-block.black{
        background-color: #000000;
        width: 100%;
        height: 235px;
        border: 1px solid #D7DBDF;
    }


    .color-block.gray{
        background-color: #D7DBDF;
        width: 100%;
        height: 235px;
        border: 1px solid #D7DBDF;
    }

    .color-block.white{
        background-color: #FFFFFF;
        width: 100%;
        height: 235px;
        border: 1px solid #D7DBDF;
    }


    .download-button:hover{
        opacity: 100%

    }


    p{
        text-align: left;
    }


    .pp-mono-header{
    font-size: 1.5rem;
    font-weight: 500;
    font-family: "PP Neue Montreal Mono";
    text-transform: uppercase;
    letter-spacing: .10em;
    line-height: 2rem;
    }

    .pp-mono-body{
    font-size: 1rem;
    line-height: 3rem;
    font-weight: 500;
    font-family: "PP Neue Montreal Mono";
    text-transform: uppercase;
    }



    .hex-copy {
    opacity: 0;
    cursor: pointer;
    padding: 10px 10px;
    color: white;
    font-family: "PP Neue Montreal Mono";
    transition: opacity 0.15s ease;
    user-select: none;
    background-color: #ffffff47;
    border-radius: 5px;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    }   

    .hex-copy.dark {
    opacity: 0;
    cursor: pointer;
    padding: 10px 10px;
    color: white;
    font-family: "PP Neue Montreal Mono";
    transition: opacity 0.15s ease;
    user-select: none;
    background-color: #00000047;
    border-radius: 5px;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    }  

    .color-block:hover .hex-copy {
        opacity: 1;
    }

    .hex-copy.copied {
        opacity: 1;
        font-family: "PP Neue Montreal Mono";
        font-size: 0.875rem;
        font-weight: 500;
        text-transform: uppercase;
        letter-spacing: 0.05em;
        color: white;
    }


</style>


