---

import IntroSection from "../components/intro-section.astro"
import LogoSection from "../components/logo-section.astro"
import PreHeader from "../components/pre-header.astro"
import LogoDownload from "../components/logo-downloads.astro"
import TypographySection from "../components/typography-section.astro"
import TypeContext from "../components/type-context.astro"
import ColorInfo from "../components/color-info.astro"
import ColorBlocks from "../components/color-blocks.astro"



---

<html lang="en">
	<head>
		<meta charset="utf-8" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="icon" href="/favicon.ico" />
		<meta name="viewport" content="width=device-width" />
		<meta name="generator" content={Astro.generator} />
		<title>Astro</title>
	</head>

	<body>



		<div class="page-wrapper"> 


			<div class="grid-container">
				<div class="vertical-borders left"> </div>
				<div class="vertical-borders right"> </div>
				<div class="no-background">
					<PreHeader/>
				</div>
			</div>

			<div class="grid-container">
				<div class="horizontal-borders top"></div>
				<div class="vertical-borders left"> </div>
				<div class="vertical-borders right"> </div>
				<div class="content">
					<IntroSection/>
					<div class="quick-links">
						<a href="#logo" class="hover-light"> Logo</a>
						<div class="vertical-line"> </div>
						<a href="#typography" class="hover-light"> Typography</a>
						<div class="vertical-line"> </div>
						<a href="#color" class="hover-light"> Colors</a>
					</div>
				</div>
			</div>
		
			<div class="grid-container" id="logo">
				<div class="horizontal-borders top"></div>
				<div class="vertical-borders left"> </div>
				<div class="vertical-borders right"> </div>
				<div class="no-background">
					<LogoSection/>
				</div>
			</div>

			<div class="grid-container">
				<div class="horizontal-borders top"></div>
				<div class="vertical-borders left"> </div>
				<div class="vertical-borders right"> </div>
				<div class="no-background">
					<LogoDownload/>
				</div>
			</div>

			<div class="grid-container" id="typography">
				<div class="horizontal-borders top"></div>
				<div class="vertical-borders left"> </div>
				<div class="vertical-borders right"> </div>
				<div class="no-background">
					<TypographySection/>
				</div>
			</div>

			<div class="grid-container">
				<div class="horizontal-borders top"></div>
				<div class="vertical-borders left"> </div>
				<div class="vertical-borders right"> </div>
				<div class="no-background no-padding">
					<TypeContext/>
				</div>
			</div>


			<div class="grid-container" id="color">
				<div class="horizontal-borders top"></div>
				<div class="vertical-borders left"> </div>
				<div class="vertical-borders right"> </div>
				<div class="no-background">
					<ColorInfo/>
				</div>
			</div>

			<div class="grid-container">
				<div class="horizontal-borders top"></div>
				<div class="vertical-borders left"> </div>
				<div class="vertical-borders right"> </div>
				<div class="no-background no-padding">
					<ColorBlocks/>
				</div>
			</div>

		</div>
	</body>
</html>







<style>

/* CSS PAGE SPECIFIC START */

.quick-links{
    display: flex;
    flex-direction: row;
    width: 100%;
    justify-content: space-evenly;
    background: rgba(0, 0, 0, 0.02);
    backdrop-filter: blur(1px);
    align-items: center;
    border-top: 1px solid #D7DBDF;
}

.logo-and-text{
    display: flex;
    flex-direction: column;
    gap: 50px;
    align-items: center;
}


.vertical-line{
    border-left: 1px solid #D7DBDF;
    height: 120px;
}

/* CSS PAGE SPECIFIC END */






/* --- GRID START --- */

.grid-container{
    display: grid;
    grid-template-columns: 150px auto 1fr auto 150px;
    grid-template-rows: 0px auto 1fr auto 0px;
    width: 100%;
}


.horizontal-borders.top {
    grid-column: 1 / -1;
    grid-row: 2;
}


.vertical-borders.left{
    border-left: 1px solid #D7DBDF;
    border-right: 1px solid #D7DBDF;
    width: 40px;
    grid-row: 2 / 5;
    grid-column: 2;

}


.vertical-borders.right{
    border-left: 1px solid #D7DBDF;
    border-right: 1px solid #D7DBDF;
    width: 40px;
    grid-row: -5 / -2;
    grid-column: 4;

}


.horizontal-borders.bottom {
    grid-column: 2 / -2;
    grid-row: 4;
}


.horizontal-borders{
    border-bottom: 1px solid #D7DBDF;
    border-top: 1px solid #D7DBDF;
    height: 40px;
    width: 100%;
    grid-column: 1 / -1;

}



.quick-links{
    display: flex;
    flex-direction: row;
    width: 100%;
    justify-content: space-evenly;
    background: rgba(0, 0, 0, 0.02);
    backdrop-filter: blur(1px);
    align-items: center;
    border-top: 1px solid #D7DBDF;
}



.vertical-line{
    border-left: 1px solid #D7DBDF;
    height: 120px;
}


/* --- GRID END --- */


</style>



